  "cards": [
    {
      "dot": "cyan",
      "title": "抓取入口",
      "items": [
        "函数式插件把提供方注册进 ctx.web 的抓取注册表，不做默认导出服务",
        "与 HTTP 抓取提供方共享同一套错误码分类，工具层无需区分后端"
      ]
    },
    {
      "dot": "emerald",
      "title": "三种浏览器后端",
      "items": [
        "local：每次抓取现开现关，上下文全新",
        "managed：DSH 常驻持久化浏览器，登录态跨抓取保留，只关标签页",
        "cdp：复用他处已启动的浏览器，默认沿用其默认上下文"
      ]
    },
    {
      "dot": "amber",
      "title": "动作与守卫",
      "items": [
        "候选按可达性排序：CSS 选择器、可见文本、角色加可访问名",
        "挑战页在同一个页面与上下文中等待并自行放行，超时才报错",
        "同意横幅只在文档足够短且词汇匹配时才允许点击"
      ]
    },
    {
      "dot": "rose",
      "title": "离线产物与边界",
      "items": [
        "开启 recordNetwork 后按标签页写 network.jsonl 与 HAR 1.2",
        "抓包全程尽力而为，CDP 或文件系统失败不会让抓取失败",
        "代理只在 local / managed 启动时注入，CDP 后端只能给出提示"
      ]
    }
  ]
}